        <item name="android:stateListAnimator">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/clay_ink</item>
    </style>

    <style name="ClayButton.Teal">
        <item name="android:background">@drawable/btn_clay_teal</item>
