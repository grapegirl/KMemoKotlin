<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="momo.kikiplus.com.kbucket.ui.view.fragment.AddFragement">

    <LinearLayout
        android:padding="10dp"
        android:id="@+id/bucketlist_back_color"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/clay_sand"
        android:orientation="vertical">

        <Button
            style="@style/ClayButton.Teal"
            android:id="@+id/interest_bucket_list_text"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_gravity="right"
            android:text="@string/interest_bucket_list_title"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            style="@style/ClayButton.Teal"
            android:id="@+id/interest_bucket_list_add"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_gravity="bottom"
            android:text="@string/interest_bucket_list_add"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ListView
            android:id="@+id/interest_bucket_list_listview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="15dp"
            android:layout_marginTop="20dp"
            android:dividerHeight="0dp" />
    </LinearLayout>
</FrameLayout>