<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="momo.kikiplus.com.kbucket.ui.view.fragment.NoticeFragment">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/notice_back_color"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/clay_sand"
        android:orientation="vertical">

    <Button
        style="@style/ClayButton.Teal"
        android:id="@+id/notice_list_text"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_gravity="right"
        android:text="공지 목록"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ExpandableListView
        android:id="@+id/notice_listview_extended"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="15dp"
        android:layout_marginTop="20dp"
        android:dividerHeight="0dp"
        android:groupIndicator="@null" />

    </LinearLayout>

</FrameLayout>
